# ==============================================================================
# Competitive Programming Platform with Hybrid Proctoring
# Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="Competitive Programming Platform"
DEBUG=true

# ------------------------------------------------------------------------------
# Backend & CORS Settings
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed origins for CORS
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# Security, Tokens & Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-very-secure-jwt-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false # Set to true in production (HTTPS required)

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cp_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
# SQLAlchemy Async Database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@postgres:5432/cp_platform

# ------------------------------------------------------------------------------
# Redis & Celery
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# Judge0 CE Execution Sandbox
# ------------------------------------------------------------------------------
JUDGE0_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_CALLBACK_SECRET=change-this-judge0-callback-hmac-secret-in-production
JUDGE0_TIMEOUT_SECONDS=10
JUDGE0_MAX_BATCH_SIZE=20

# ------------------------------------------------------------------------------
# S3 / MinIO Object Storage
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_EVIDENCE=cp-evidence-screenshots
S3_BUCKET_TESTCASES=cp-hidden-testcases
S3_PRESIGNED_EXPIRATION_SECONDS=900

# ------------------------------------------------------------------------------
# Hybrid Proctoring Settings
# ------------------------------------------------------------------------------
PROCTORING_SCREENSHOT_INTERVAL_SEC=60
PROCTORING_SCREENSHOT_MAX_WIDTH=640
PROCTORING_SCREENSHOT_MAX_HEIGHT=360
PROCTORING_SCREENSHOT_MAX_KB=100
PROCTORING_TAB_COOLDOWN_SECONDS=30
PROCTORING_EVIDENCE_RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# Email / SMTP Configuration
# ------------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAILS_FROM_EMAIL=no-reply@cpplatform.local
EMAILS_FROM_NAME="Competitive Programming Platform"

# ------------------------------------------------------------------------------
# Frontend (Next.js) Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
